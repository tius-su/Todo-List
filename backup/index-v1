                renderHabits();
                updateStats();
            });
        }

        // --- Notification System ---
        window.checkNotificationPermission = () => {
            if (!("Notification" in window)) {
                console.log("Browser tidak support notifikasi");
                return;
            }
            
            if (Notification.permission === "default") {
                document.getElementById('notif-banner').style.display = 'flex';
            } else if (Notification.permission === "granted") {
                document.getElementById('notif-banner').style.display = 'none';
            }
        };

        window.requestNotificationPermission = () => {
            Notification.requestPermission().then(permission => {
                if (permission === "granted") {
                    document.getElementById('notif-banner').style.display = 'none';
                    new Notification("Super Planner", {
                        body: "Notifikasi diaktifkan! Anda akan seringkat saat waktu tugas tiba.",
                        icon: "https://cdn-icons-png.flaticon.com/512/2693/2693507.png"
                    });
                }
            });
        };

        window.sendNotification = (title, body) => {
    let repeatCount = 0;
    let maxRepeat = 3;
    

    const audio = document.getElementById('notif-sound');

    function playAlarm() {
        // 🔊 Bunyi alarm
        if (audio) {
            audio.currentTime = 0;
            audio.play().catch(() => {});
        }

        // 🔔 Notifikasi browser (tidak hilang otomatis)
        if (Notification.permission === "granted") {
            new Notification(title, {
                body: body,
                requireInteraction: true,
                vibrate: [200, 100, 200]
            });
        }

        // 📢 Popup paksa
        alert(`🔔 ${title}\n\n${body}`);

        repeatCount++;

        // 🔁 Ulang beberapa kali (seperti alarm)
        if (repeatCount < maxRepeat) {
            setTimeout(playAlarm, 5000);
        } else {
            // 🛑 stop audio setelah selesai
            if (audio) {
                audio.pause();
                audio.currentTime = 0;
            }
        }
    }

    playAlarm();
};

        // --- Advanced Reminder System ---
        window.checkReminders = () => {
            const now = new Date();
            const currentTime = now.toTimeString().slice(0, 5); // HH:MM
            
            allTasks.forEach(task => {
                if (task.completed) return;
                
                // Check reminders array
                if (task.reminders && task.reminders.length > 0) {
                    task.reminders.forEach((reminder, index) => {
                        if (!reminder.time) return;
                        
                        const shouldNotify = checkReminderCondition(reminder, now, task);
                        
                        const reminderKey = `${task.id}-${index}-${now.toDateString()}`;
                        
                        if (shouldNotify && !notifiedTasks.has(reminderKey)) {
                            sendNotification("⏰ Pengingat Tugas!", `${task.text}\nWaktu: ${reminder.time} (${getReminderLabel(reminder.type)})`);
                            notifiedTasks.add(reminderKey);
                            
                            // Clean up old keys
                            if (notifiedTasks.size > 1000) {
                                const keysArray = Array.from(notifiedTasks);
                                notifiedTasks = new Set(keysArray.slice(-500));
                            }
                        }
                    });
                }
                
                // Legacy single reminder support
                if (task.time && task.date) {
                    const taskDateTime = `${task.date}T${task.time}`;
                    const taskTime = new Date(taskDateTime);
                    const timeDiff = taskTime - now;
                    
                    if (timeDiff >= -60000 && timeDiff <= 300000 && !notifiedTasks.has(task.id)) {
                        sendNotification("⏰ Pengingat Tugas!", `${task.text}\nWaktu: ${task.time}`);
                        notifiedTasks.add(task.id);
                    }
                    
                    if (timeDiff < 0) {
                        notifiedTasks.delete(task.id);
                    }
                }
            });
        };

        function checkReminderCondition(reminder, now, task) {
            const reminderTime = reminder.time;
            const currentTime = now.toTimeString().slice(0, 5);
            
            // Check if time matches
            if (reminderTime !== currentTime) return false;
            
            const dayOfWeek = now.getDay(); // 0 = Sunday
            const dateOfMonth = now.getDate();
            
            switch (reminder.type) {
                case 'once':
                    // Check if this reminder was already triggered today
                    const today = now.toDateString();
                    const lastTriggered = reminder.lastTriggered;
                    return lastTriggered !== today;
                    
                case 'daily':
                    return true;
                    
                case 'weekly':
                    // Trigger on specific day of week
                    return reminder.dayOfWeek === dayOfWeek;
                    
                case 'monthly':
                    // Trigger on specific day of month
                    return reminder.dayOfMonth === dateOfMonth;
                    
                case 'custom':
                    // Custom interval
                    if (reminder.untilDelete === false) {
                        // Check if custom interval has passed
                        const lastTrigger = reminder.lastTriggered ? new Date(reminder.lastTriggered) : null;
                        if (!lastTrigger) return true;
                        
                        const diff = now - lastTrigger;
                        const intervalMs = getCustomIntervalMs(reminder);
                        return diff >= intervalMs;
                    }
                    return true;
                    
                default:
                    return false;
            }
        }

        function getCustomIntervalMs(reminder) {
            const value = reminder.value || 1;
            const unit = reminder.unit || 'days';
            
            switch (unit) {
                case 'hours': return value * 60 * 60 * 1000;
                case 'days': return value * 24 * 60 * 60 * 1000;
                case 'weeks': return value * 7 * 24 * 60 * 60 * 1000;
                default: return value * 24 * 60 * 60 * 1000;
            }
        }

        function getReminderLabel(type) {
            switch (type) {
                case 'once': return 'Sekali';
                case 'daily': return 'Harian';
                case 'weekly': return 'Mingguan';
                case 'monthly': return 'Bulanan';
                case 'custom': return 'Custom';
                default: return type;
            }
        }

        // --- Reminder UI Functions ---
        function setupReminderOptions() {
            const options = document.querySelectorAll('.reminder-option input');
            options.forEach(option => {
                option.addEventListener('change', (e) => {
                    document.querySelectorAll('.reminder-option').forEach(o => o.classList.remove('active'));
                    e.target.parentElement.classList.add('active');
                    
                    const customDiv = document.getElementById('custom-reminder-options');
                    if (e.target.value === 'custom') {
                        customDiv.classList.add('show');
                    } else {
                        customDiv.classList.remove('show');
                    }
                });
            });
            
            // Set default active
            document.getElementById('reminder-once').classList.add('active');
        }

        window.addMultipleReminders = () => {
            document.getElementById('reminder-modal').style.display = 'flex';
        };

        window.saveModalReminder = () => {
            const type = document.getElementById('modal-reminder-type').value;
            const time = document.getElementById('modal-reminder-time').value;
            
            if (!time) {
                alert('Mohon pilih waktu pengingat');
                return;
            }
            
            const reminder = {
                type: type,
                time: time,
                createdAt: Date.now()
            };
            
            if (type === 'custom') {
                reminder.value = parseInt(document.getElementById('modal-custom-value').value) || 1;
                reminder.unit = document.getElementById('modal-custom-unit').value;
                reminder.untilDelete = document.getElementById('modal-until-delete').checked;
            } else if (type === 'weekly') {
                reminder.dayOfWeek = new Date().getDay();
            } else if (type === 'monthly') {
                reminder.dayOfMonth = new Date().getDate();
            }
            
            pendingReminders.push(reminder);
            renderPendingReminders();
            closeReminderModal();
        };

        window.closeReminderModal = () => {
            document.getElementById('reminder-modal').style.display = 'none';
        };

        function renderPendingReminders() {
            const container = document.getElementById('multi-reminder-list');
            container.innerHTML = '';
            
            pendingReminders.forEach((reminder, index) => {
                const el = document.createElement('div');
                el.className = 'reminder-item';
                el.innerHTML = `
                    <span class="badge-reminder-type">${getReminderLabel(reminder.type)}</span>
                    <span><i class="fas fa-clock"></i> ${reminder.time}</span>
                    <i class="fas fa-times remove-reminder" onclick="removePendingReminder(${index})"></i>
                `;
                container.appendChild(el);
            });
        }

        window.removePendingReminder = (index) => {
            pendingReminders.splice(index, 1);
            renderPendingReminders();
        };

        // --- Natural Language Processing (Lite) ---
        window.parseNaturalLanguage = () => {
            const input = document.getElementById('task-input').value.toLowerCase();
            const today = new Date();
            
            if (input.includes('besok')) {
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);
                document.getElementById('task-date').valueAsDate = tomorrow;
            } 
            else if (input.includes('lusa')) {
                const dayAfter = new Date(today);
                dayAfter.setDate(dayAfter.getDate() + 2);
                document.getElementById('task-date').valueAsDate = dayAfter;
            }
            else {
                document.getElementById('task-date').valueAsDate = today;
            }

            if (input.includes('prioritas tinggi') || input.includes('urgent')) {
                document.getElementById('task-priority').value = 'high';
            } else if (input.includes('prioritas rendah')) {
                document.getElementById('task-priority').value = 'low';
            } else {
                document.getElementById('task-priority').value = 'med';
            }

            const timeMatch = input.match(/jam\s(\d{1,2})(?::(\d{2}))?/);
            if (timeMatch) {
                let h = timeMatch[1].padStart(2, '0');
                let m = timeMatch[2] || '00';
                document.getElementById('task-time').value = `${h}:${m}`;
            }
        };

        function setupDateInputs() {
            document.getElementById('task-date').valueAsDate = new Date();
        }

        // --- Task Logic ---
        window.addTask = () => {
            const text = document.getElementById('task-input').value;
            if (!text) return alert('Isi tugas dulu!');

            const reminderType = document.querySelector('input[name="reminder-type"]:checked').value;
            const time = document.getElementById('task-time').value;
            
            // Build reminders array
            let reminders = [];
            
            if (time) {
                const primaryReminder = {
                    type: reminderType,
                    time: time,
                    createdAt: Date.now()
                };
                
                if (reminderType === 'custom') {
                    primaryReminder.value = parseInt(document.getElementById('custom-repeat-value').value) || 1;
                    primaryReminder.unit = document.getElementById('custom-repeat-type').value;
                    primaryReminder.untilDelete = document.getElementById('custom-until-delete').checked;
                } else if (reminderType === 'weekly') {
                    primaryReminder.dayOfWeek = new Date().getDay();
                } else if (reminderType === 'monthly') {
                    primaryReminder.dayOfMonth = new Date().getDate();
                }
                
                reminders.push(primaryReminder);
            }
            
            // Add pending reminders from multi-reminder
            reminders = [...reminders, ...pendingReminders];

            const newTask = {
                text: text,
                date: document.getElementById('task-date').value,
                time: time || null,
                priority: document.getElementById('task-priority').value,
                category: document.getElementById('task-category').value,
                tags: document.getElementById('task-tags').value,
                completed: false,
                pinned: false,
                createdAt: Date.now(),
                notified: false,
                reminders: reminders
            };

            push(tasksRef, newTask);
            
            // Reset form
            document.getElementById('task-input').value = '';
            document.getElementById('task-tags').value = '';
            pendingReminders = [];
            renderPendingReminders();
        };

        window.toggleTask = (id, currentStatus) => {
            update(ref(db, `tasks/${id}`), { completed: !currentStatus });
            if (!currentStatus) notifiedTasks.delete(id);
        };

        window.pinTask = (id, currentPin) => {
            update(ref(db, `tasks/${id}`), { pinned: !currentPin });
        };

        window.deleteTask = (id) => {
            if(confirm('Hapus tugas ini?')) {
                remove(ref(db, `tasks/${id}`));
                notifiedTasks.delete(id);
            }
        };

        window.openEdit = (id) => {
            const task = allTasks.find(t => t.id === id);
            currentEditTaskId = id;
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-title').value = task.text;
            document.getElementById('edit-priority').value = task.priority;
            
            // Render existing reminders
