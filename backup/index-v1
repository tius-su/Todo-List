        function loadData() {
            onValue(tasksRef, (snapshot) => {
                const data = snapshot.val();
                allTasks = data ? Object.entries(data).map(([id, val]) => ({id, ...val})) : [];
                allTasks.sort((a, b) => {
                    if (a.pinned === b.pinned) return new Date(a.date) - new Date(b.date);
                    return b.pinned ? 1 : -1;
                });
                renderTasks();
                renderCalendar();
                updateStats();
                checkReminders();
