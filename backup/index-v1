        window.renderTasks = () => {
            const container = document.getElementById('task-list-container');
            const search = document.getElementById('search-input').value.toLowerCase();
            container.innerHTML = '';

            let filtered = allTasks.filter(t => t.text.toLowerCase().includes(search));
            
            // Apply filter
            if (currentFilter === 'active') {
                filtered = filtered.filter(t => !t.completed);
            } else if (currentFilter === 'completed') {
                filtered = filtered.filter(t => t.completed);
            } else if (currentFilter === 'reminder') {
                filtered = filtered.filter(t => t.reminders && t.reminders.length > 0);
            }

            if (filtered.length === 0) {
                container.innerHTML = '<div style="text-align:center; padding: 20px; color: var(--text-sub);">Tidak ada tugas ditemukan</div>';
                return;
            }

            filtered.forEach(task => {
                const el = document.createElement('div');
                el.className = `task-item p-${task.priority} ${task.completed ? 'completed' : ''} ${task.pinned ? 'pinned' : ''}`;
                
                // Check if reminder should show
                let reminderBadge = '';
                const hasReminders = task.reminders && task.reminders.length > 0;
                if (!task.completed && hasReminders) {
                    reminderBadge = `<span class="badge badge-reminder"><i class="fas fa-bell"></i> ${task.reminders.length} alarm</span>`;
                } else if (!task.completed && task.time && task.date) {
                    const taskTime = new Date(`${task.date}T${task.time}`);
                    const now = new Date();
                    const diff = taskTime - now;
                    if (diff > 0 && diff <= 3600000) {
                        reminderBadge = `<span class="badge badge-reminder"><i class="fas fa-bell"></i> Segera</span>`;
                    }
                }
                
                let badges = '';
                if(task.priority === 'high') badges += `<span class="badge badge-p-high">High</span>`;
                else if(task.priority === 'med') badges += `<span class="badge badge-p-med">Med</span>`;
                else badges += `<span class="badge badge-p-low">Low</span>`;
                
                badges += `<span class="badge badge-cat">${task.category}</span>`;
                if(task.tags) badges += `<span class="badge" style="background:transparent; border:1px solid var(--border)">${task.tags}</span>`;
                if(reminderBadge) badges += reminderBadge;

                el.innerHTML = `
                    <div class="task-check" onclick="toggleTask('${task.id}', ${task.completed})">
                        ${task.completed ? '<i class="fas fa-check"></i>' : ''}
                    </div>
                    <div class="task-content">
                        <div class="task-title">${task.text}</div>
                        <div class="task-meta">
                            <span><i class="far fa-calendar"></i> ${formatDate(task.date)}</span>
                            ${task.time ? `<span><i class="far fa-clock"></i> ${task.time}</span>` : ''}
                            ${badges}
                        </div>
                    </div>
                    <div class="task-actions">
                        <button class="icon-btn" onclick="pinTask('${task.id}', ${task.pinned})"><i class="fas fa-thumbtack"></i></button>
                        <button class="icon-btn" onclick="openEdit('${task.id}')"><i class="fas fa-pen"></i></button>
                        <button class="icon-btn delete" onclick="deleteTask('${task.id}')"><i class="fas fa-trash"></i></button>
                    </div>
                `;
                container.appendChild(el);
            });
        };

        window.filterTasks = (filter) => {
            currentFilter = filter;
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderTasks();
        };

        // --- Habit Logic ---
        window.addHabit = () => {
            const name = document.getElementById('habit-input').value;
            if(!name) return;
            push(habitsRef, {
                name: name,
                count: 0,
                lastDone: null
            });
            document.getElementById('habit-input').value = '';
        };

        window.checkHabit = (id, currentCount) => {
            const today = new Date().toDateString();
            update(ref(db, `habits/${id}`), { count: currentCount + 1, lastDone: today });
        };

        window.renderHabits = () => {
            const container = document.getElementById('habit-list-container');
            container.innerHTML = '';
