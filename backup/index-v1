            reminders.forEach((reminder, index) => {
                const el = document.createElement('div');
                el.className = 'reminder-list-item';
                el.innerHTML = `
                    <div class="reminder-info">
                        <div class="reminder-type">${getReminderLabel(reminder.type)}</div>
